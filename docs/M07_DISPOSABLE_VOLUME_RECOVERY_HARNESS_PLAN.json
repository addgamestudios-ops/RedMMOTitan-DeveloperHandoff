  "safety_guards": [
    {
      "id": "G01",
      "rule": "provisioning requires a previously absent image beneath the exact allowlisted run root"
    },
    {
      "id": "G02",
      "rule": "destructive provisioning authority is the complete creating-handle identity chain, never a disk number alone"
    },
    {
      "id": "G03",
      "rule": "pre and post device inventories must identify exactly one new device linked to the created image"
    },
    {
      "id": "G04",
      "rule": "the disposable volume identity must differ from Windows, user, repository, diagnostics, manifest, protected-map, and ledger volumes"
    },
    {
      "id": "G05",
      "rule": "worker cwd, temp, pycache, payload, staging, and final paths must resolve inside the exact disposable case root"
    },
    {
      "id": "G06",
      "rule": "a complete write trace is mandatory and any outside write fails closed"
    },
    {
      "id": "G07",
      "rule": "the controller may terminate only its nonce-authenticated direct child after an armed checkpoint acknowledgement"
    },
    {
      "id": "G08",
      "rule": "case roots, report names, ledgers, and outputs are no-clobber and single-use"
    },
    {
      "id": "G09",
      "rule": "failed or ambiguous cases are preserved and cleanup is never automatic"
    },
    {
      "id": "G10",
      "rule": "protected hashes, canonical manifest digest, and worktree snapshot must match before and after"
    }
  ],
  "controller_state_machine": [
    "NEW",
    "VOLUME_ATTESTED",
    "PLAN_BOUND",
    "CASE_CREATED",
    "WORKER_READY",
